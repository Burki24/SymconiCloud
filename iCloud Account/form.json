{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Enabled",
            "caption": "Enable account"
        },
        {
            "type": "CheckBox",
            "name": "PauseRequests",
            "caption": "Pause Apple requests (keep session)"
        },
        {
            "type": "Label",
            "caption": "Pause stops Apple requests, including sign-in and device commands, without deleting the session or cache. Apply the configuration to change the pause."
        },
        {
            "type": "ValidationTextBox",
            "name": "Username",
            "caption": "Apple account"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Apple account password"
        },
        {
            "type": "NumberSpinner",
            "name": "RefreshInterval",
            "caption": "Refresh interval in seconds",
            "minimum": 60,
            "maximum": 86400
        },
        {
            "type": "Label",
            "caption": "Use the account password, not an app-specific password. Save settings before signing in."
        },
        {
            "type": "ExpansionPanel",
            "caption": "iCloud Photos (optional)",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "EnablePhotos",
                    "caption": "Enable read-only Photos access"
                },
                {
                    "type": "Select",
                    "name": "PhotoCacheProfile",
                    "caption": "Photo resource profile",
                    "options": [
                        {
                            "caption": "Compact: 50 images / 100 MiB",
                            "value": "compact"
                        },
                        {
                            "caption": "Standard: 250 images / 500 MiB",
                            "value": "standard"
                        },
                        {
                            "caption": "Large: 1000 images / 2 GiB",
                            "value": "large"
                        },
                        {
                            "caption": "Custom limits",
                            "value": "custom"
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "PhotoCacheImages",
                    "caption": "Custom maximum cached images",
                    "minimum": 1,
                    "maximum": 100000
                },
                {
                    "type": "NumberSpinner",
                    "name": "PhotoCacheMiB",
                    "caption": "Custom disk cache in MiB",
                    "minimum": 1,
                    "maximum": 65536
                },
                {
                    "type": "Label",
                    "caption": "One disk cache per account. The first count or byte limit reached applies. Older images are evicted as needed; larger albums remain browsable. Custom limits apply only to the Custom profile."
                },
                {
                    "type": "Label",
                    "caption": "Photos require iCloud web access. Advanced Data Protection may require approval on a trusted device. This module does not change Apple protection settings."
                },
                {
                    "type": "Button",
                    "caption": "Check Photos access and load albums",
                    "onClick": "ICAC_RefreshPhotoAlbums($id);"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "Session state"
        },
        {
            "type": "Label",
            "caption": ""
        },
        {
            "type": "Button",
            "caption": "Sign in",
            "onClick": "ICAC_Login($id);"
        },
        {
            "type": "ExpansionPanel",
            "name": "TwoFactor",
            "caption": "Two-factor authentication",
            "visible": false,
            "items": [
                {
                    "type": "PasswordTextBox",
                    "name": "Code",
                    "caption": "Verification code"
                },
                {
                    "type": "Button",
                    "caption": "Verify code",
                    "onClick": "ICAC_VerifyCode($id, $Code);"
                },
                {
                    "type": "Button",
                    "caption": "Request new code",
                    "onClick": "ICAC_ResendCode($id);"
                }
            ]
        },
        {
            "type": "Button",
            "caption": "Refresh devices",
            "onClick": "ICAC_RefreshDevices($id);"
        },
        {
            "type": "Button",
            "caption": "Delete local session",
            "onClick": "ICAC_Logout($id);",
            "confirm": "Delete the local session and cached device data?"
        },
        {
            "type": "Label",
            "caption": "Account protection: at most 3 password logins per 30 minutes, at least 60 seconds apart; 5 code checks and 3 code requests per 10 minutes. Limits persist after restart, logout and credential changes."
        },
        {
            "type": "Button",
            "caption": "Resume after checking the Apple account",
            "onClick": "ICAC_ResumeAccountRequests($id);",
            "confirm": "Have you checked or unlocked the Apple account? This only releases the local hold. Existing cooldowns and attempt limits remain; no sign-in is started."
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Authenticated"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Disabled or signed out"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Invalid configuration"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Verification code required"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Session expired"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Apple request failed"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "PHP extension missing"
        },
        {
            "code": 206,
            "icon": "error",
            "caption": "Apple requests a pause"
        },
        {
            "code": 207,
            "icon": "inactive",
            "caption": "Apple requests paused (session retained)"
        },
        {
            "code": 208,
            "icon": "error",
            "caption": "Account requests stopped: manual review required"
        },
        {
            "code": 209,
            "icon": "error",
            "caption": "Local authentication attempt limit reached"
        },
        {
            "code": 210,
            "icon": "error",
            "caption": "Temporary connection retry pause"
        }
    ]
}
